KC_DB=postgres
KC_DB_URL=jdbc:postgresql://DATABASE_HOST:5432/tawsel_identity?sslmode=verify-full&sslrootcert=/run/secrets/ca.pem
KC_DB_USERNAME=tawsel_identity_owner
KC_DB_PASSWORD=REPLACE
KC_HOSTNAME=https://ISSUER_DOMAIN
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
# Set the actual ingress CIDR; do not trust arbitrary forwarded headers.
KC_PROXY_TRUSTED_ADDRESSES=REPLACE_WITH_INGRESS_CIDR
# Database CA is mounted read-only at /run/secrets/ca.pem.
# Bootstrap credentials are only set for the initial protected setup, then removed.

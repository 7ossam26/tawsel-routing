# External secret file: supply real values, never commit the populated file.
TAWSEL_DATABASE_URL=postgresql://tawsel_owner:REPLACE@DATABASE_HOST:5432/tawsel_app_pilot?sslmode=verify-full
TAWSEL_ORIGIN=https://APP_DOMAIN
TAWSEL_SESSION_KEY=REPLACE_WITH_64_HEX
TAWSEL_COMPANY_ISSUER=https://ISSUER_DOMAIN/realms/tawsel-company
TAWSEL_COMPANY_CLIENT_ID=tawsel-web
TAWSEL_COMPANY_CLIENT_SECRET=REPLACE
TAWSEL_PERSONAL_ISSUER=https://ISSUER_DOMAIN/realms/tawsel-personal
TAWSEL_PERSONAL_CLIENT_ID=tawsel-web
TAWSEL_PERSONAL_CLIENT_SECRET=REPLACE
TAWSEL_ISSUER_WORKER_CLIENT_ID=tawsel-provisioning
TAWSEL_ISSUER_WORKER_CLIENT_SECRET=REPLACE
TAWSEL_OUTBOX_CONFIG_FILE=/run/secrets/outbox.json
TAWSEL_OSRM_CAR_URL=http://ENGINE_CAR_ALIAS:5000
TAWSEL_OSRM_BICYCLE_URL=http://ENGINE_BICYCLE_ALIAS:5000
TAWSEL_OSRM_MOTORCYCLE_URL=http://ENGINE_MOTORCYCLE_ALIAS:5000
TAWSEL_VROOM_URL=http://ENGINE_VROOM_ALIAS:3000
TAWSEL_NOMINATIM_URL=http://ENGINE_NOMINATIM_ALIAS:8080

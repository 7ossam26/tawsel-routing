[global]
repo1-type=s3
repo1-s3-bucket=REPLACE_WITH_PRIVATE_BUCKET
repo1-s3-endpoint=REPLACE_WITH_S3_ENDPOINT
repo1-s3-region=REPLACE_WITH_REGION
repo1-s3-key=REPLACE_WITH_ACCESS_KEY
repo1-s3-key-secret=REPLACE_WITH_SECRET_KEY
repo1-path=/tawsel/pilot/postgres
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REPLACE_WITH_ESCROWED_RANDOM_PASSPHRASE
repo1-retention-full=7
repo1-retention-full-type=count
archive-async=y
spool-path=/var/lib/postgresql/pgbackrest-spool

[tawsel]
pg1-path=/var/lib/postgresql/18/docker

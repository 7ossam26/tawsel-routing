# Copy to an external operator-controlled file and fill from actual inventory.
RELEASE_PROJECT=tawsel-pilot
APP_IMAGE=REPLACE_WITH_REGISTRY_IMAGE_AT_SHA256
WEB_IMAGE=REPLACE_WITH_REGISTRY_IMAGE_AT_SHA256
ISSUER_IMAGE=REPLACE_WITH_REGISTRY_IMAGE_AT_SHA256
INGRESS_NETWORK=REPLACE_WITH_DOKPLOY_NETWORK
ENGINE_NETWORK=REPLACE_WITH_PRIVATE_ENGINE_NETWORK
RETAINED_ASSETS_VOLUME=REPLACE_WITH_PRECREATED_VOLUME
MAP_ASSET_DIR=/REPLACE/existing/maps
RUNTIME_ENV_FILE=/REPLACE/secrets/runtime.env
ISSUER_ENV_FILE=/REPLACE/secrets/issuer.env
DATABASE_CA_FILE=/REPLACE/secrets/ca.pem
OUTBOX_CONFIG_FILE=/REPLACE/secrets/outbox.json
RUNTIME_CPUS=REPLACE_FROM_INVENTORY
RUNTIME_MEMORY=REPLACE_FROM_INVENTORY
WEB_CPUS=REPLACE_FROM_INVENTORY
WEB_MEMORY=REPLACE_FROM_INVENTORY
ISSUER_CPUS=REPLACE_FROM_INVENTORY

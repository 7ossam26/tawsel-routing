{
  "name": "@tawsel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tawsel/shared": "0.1.0",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}

# Local application values only. This file contains no production secret.
# Port 3001 deliberately avoids the retained VROOM Engine on port 3000.
TAWSEL_API_HOST=127.0.0.1
TAWSEL_API_PORT=3001
VITE_TAWSEL_API_BASE_URL=http://127.0.0.1:3001

# Run npm run db:local:start on Windows to create .env.database.local with
# generated local credentials for a SEPARATE PostgreSQL 18 cluster on 55432.
# Other hosts: provision dedicated databases with the markers in docs/operations.md.
# TAWSEL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tawsel_app_dev?sslmode=verify-full
# TAWSEL_TEST_ADMIN_URL targets loopback /tawsel_test_control, never an Engine DB.

# P07: npm run identity:install generates ignored .env.identity.local; never copy
# its secrets into source control. Production needs HTTPS and distinct realms.
# TAWSEL_ORIGIN=https://tawsel.example
# TAWSEL_SESSION_KEY=<64 hex characters from a secure random generator>
# TAWSEL_COMPANY_ISSUER=https://identity.example/realms/company
# TAWSEL_COMPANY_CLIENT_ID=tawsel-web
# TAWSEL_COMPANY_CLIENT_SECRET=<secret>
# TAWSEL_PERSONAL_ISSUER=https://identity.example/realms/personal
# TAWSEL_PERSONAL_CLIENT_ID=tawsel-web
# TAWSEL_PERSONAL_CLIENT_SECRET=<different secret>

# P08 operator bootstrap/recovery only; omit to close that surface.
# TAWSEL_PROVISIONING_OPERATOR_TOKEN=<32 random bytes as 64 lowercase hex characters>
# Separate worker process only; use a dedicated company-realm client in deployment.
# TAWSEL_ISSUER_WORKER_CLIENT_ID=<user-view and session-logout service client>
# TAWSEL_ISSUER_WORKER_CLIENT_SECRET=<secret>
# npm run provisioning:local:setup creates ignored local fixture configuration.

# P11 private geocoder only. No public fallback or import during app startup.
# TAWSEL_NOMINATIM_URL=http://127.0.0.1:8080/
# TAWSEL_MAP_ASSET_DIR=C:/path/to/tawsel/.local/maps
# Explicit asset preparation: powershell -File scripts/maps-prepare.ps1

# P12 private Engine origins. Distinct datasets/services; no public fallback.
# Ordinary application startup never imports OSM or starts Engine containers.
# TAWSEL_OSRM_CAR_URL=http://127.0.0.1:5001
# TAWSEL_OSRM_MOTORCYCLE_URL=http://127.0.0.1:5003
# TAWSEL_OSRM_BICYCLE_URL=http://127.0.0.1:5002
# TAWSEL_VROOM_URL=http://127.0.0.1:3000
# TAWSEL_ENGINE_TIMEOUT_MS=5000
# TAWSEL_ENGINE_MAX_CONCURRENT=4
# npm run engine:demo = controlled HTTP; npm run engine:live = explicit live probe.
# P13: npm run planning:worker uses the database and Engine settings above.
# Claims are durable; default 90s lease, three automatic attempts, one job/process.
# npm run planning:demo uses isolated PostgreSQL + controlled HTTP, never live routing.

# P25: absolute path to protected operator JSON; see docs/outbox-delivery.md.
# TAWSEL_OUTBOX_CONFIG_FILE=C:/private/tawsel-outbox.json

# P38 deployment operator diagnostics. Omit the token to disable /internal/diagnostics/*.
# Use a separate random read-only secret; never share with drivers or ERP consumers.
# TAWSEL_DIAGNOSTICS_TOKEN=<at least 32 random URL-safe characters>
# TAWSEL_DIAGNOSTICS_URL=http://127.0.0.1:3001
# Production main enables safe structured logs; set 0 only for deliberate quiet operation.
# TAWSEL_STRUCTURED_LOGS=1

# Local application values only. This file contains no production secret.
# Port 3001 deliberately avoids the retained VROOM Engine on port 3000.
TAWSEL_API_HOST=127.0.0.1
TAWSEL_API_PORT=3001
VITE_TAWSEL_API_BASE_URL=http://127.0.0.1:3001

# Run npm run db:local:start on Windows to create .env.database.local with
# generated local credentials for a SEPARATE PostgreSQL 18 cluster on 55432.
# Other hosts: provision dedicated databases with the markers in docs/operations.md.
# TAWSEL_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tawsel_app_dev?sslmode=verify-full
# TAWSEL_TEST_ADMIN_URL targets loopback /tawsel_test_control, never an Engine DB.

# P07: npm run identity:install generates ignored .env.identity.local; never copy
# its secrets into source control. Production needs HTTPS and distinct realms.
# TAWSEL_ORIGIN=https://tawsel.example
# TAWSEL_SESSION_KEY=<64 hex characters from a secure random generator>
# TAWSEL_COMPANY_ISSUER=https://identity.example/realms/company
# TAWSEL_COMPANY_CLIENT_ID=tawsel-web
# TAWSEL_COMPANY_CLIENT_SECRET=<secret>
# TAWSEL_PERSONAL_ISSUER=https://identity.example/realms/personal
# TAWSEL_PERSONAL_CLIENT_ID=tawsel-web
# TAWSEL_PERSONAL_CLIENT_SECRET=<different secret>

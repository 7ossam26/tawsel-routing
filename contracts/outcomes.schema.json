        },
        "roundId": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "workdayId": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "driverId": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "taskId": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "attemptId": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "dispatchCycleId": {
          "anyOf": [
            {
              "$ref": "./common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "branchId": {
          "anyOf": [
            {
              "$ref": "./common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceReference": {
          "anyOf": [
            {
              "$ref": "./common.schema.json#/$defs/SourceReference"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceRevision": {
          "$ref": "./common.schema.json#/$defs/Revision"
        },
        "assignmentRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "time": {
          "$ref": "./current-activity.schema.json#/$defs/ActionTime"
        },
        "heading": {
          "anyOf": [
            {
              "$ref": "./current-activity.schema.json#/$defs/ActionTime"
            },

        "externalId",
        "sourceDispatchCycleId",
        "expectedSourceRevision",
        "expectedAssignmentRevision",
        "assignmentRevision"
      ],
      "additionalProperties": false
    },
    "Reassign": {
      "type": "object",
      "properties": {
        "externalId": {
          "$ref": "./common.schema.json#/$defs/ExternalId"
        },
        "sourceDispatchCycleId": {
          "$ref": "./common.schema.json#/$defs/ExternalId"
        },
        "expectedSourceRevision": {
          "$ref": "./common.schema.json#/$defs/Revision"
        },
        "expectedAssignmentRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assignmentRevision": {
          "$ref": "./common.schema.json#/$defs/Revision"
        },
        "driverExternalId": {
          "$ref": "./common.schema.json#/$defs/ExternalId"
        },
        "receiptAsserted": {
          "type": "boolean"
        }
      },
      "required": [
        "externalId",
        "sourceDispatchCycleId",
        "expectedSourceRevision",
        "expectedAssignmentRevision",
        "assignmentRevision",

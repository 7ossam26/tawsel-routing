        },
        "expectedSourceRevision": {
          "$ref": "./common.schema.json#/$defs/Revision"
        },
        "expectedAssignmentRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assignmentRevision": {
          "$ref": "./common.schema.json#/$defs/Revision"
        }
      },
      "required": [
        "externalId",
        "sourceDispatchCycleId",
        "expectedSourceRevision",
        "expectedAssignmentRevision",
        "assignmentRevision"
      ],
      "additionalProperties": false
    },
    "Prepare": {
      "type": "object",
      "properties": {
        "driverExternalId": {
          "$ref": "./common.schema.json#/$defs/ExternalId"
        },
        "items": {

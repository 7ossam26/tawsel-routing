      "required": [
        "schemaVersion",
        "payloadVersion",
        "actionId",
        "operationId",
        "context",
        "resources",
        "baseVersions",
        "dependsOnActionIds",
        "observation",
        "payload"
      ],
      "additionalProperties": false
    },

    },
    "ReceiveBatch": {
      "type": "object",
      "properties": {
        "driverExternalId": {
          "$ref": "./common.schema.json#/$defs/ExternalId"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssignmentReference"
          },
          "minItems": 1,
          "maxItems": 100
        },
        "receiptAsserted": {
          "const": true
        }
      },
      "required": [
        "driverExternalId",
        "items",
        "receiptAsserted"
      ],
      "additionalProperties": false
    },
    "Withdraw": {
      "type": "object",

          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "sourceRevision": {
          "$ref": "./common.schema.json#/$defs/Revision"
        },
        "lastActionId": {
          "$ref": "./common.schema.json#/$defs/Uuid"
        },
        "issuerStatus": {
          "enum": [
            "not-required",
            "pending",
            "running",
            "retry",
            "ready"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "nextAttemptAt": {
          "anyOf": [
            {
              "$ref": "./common.schema.json#/$defs/UtcInstant"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastError": {
          "enum": [
            null,
            "issuer_unavailable",
            "subject_unavailable"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Requested local projection enabled state; null for a role. ready plus enabled=false means disable reconciliation completed, never account-ready."
        }
      },
      "required": [
        "entity",
        "externalId",
        "resourceId",
        "sourceRevision",
        "lastActionId",
        "issuerStatus",
        "attempts",
        "nextAttemptAt",
        "lastError",
        "enabled"
      ],
